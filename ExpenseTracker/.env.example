# =============================================================================
# Copy to `.env` and edit. Compose reads `.env` automatically and substitutes
# these into docker-compose.yml. See notes/chapter-7 §6.1.
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is committed so everyone knows which knobs
# exist. Never put real secrets in THIS file.
#
# Every value has a default in docker-compose.yml, so the stack comes up even
# without a .env — those defaults are for local development only.
# =============================================================================

# --- MySQL (both services) ---------------------------------------------------
# One server, two schemas — neither service reads the other's tables (§8.1).
#   MYSQL_USER_DB is created by the image from MYSQL_DATABASE.
#   MYSQL_AUTH_DB is created by infra/mysql/init-databases.sql.
#
# NOTE: if you change MYSQL_USER, also edit the hardcoded 'appuser' in
# infra/mysql/init-databases.sql, then `docker compose down -v` — init scripts
# only run against an empty volume.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=appuser
MYSQL_PASSWORD=AppPass123
MYSQL_AUTH_DB=authservice
MYSQL_USER_DB=userservice
MYSQL_EXPENSE_DB=expenseservice

# Hibernate schema handling. `update` keeps your data across restarts.
# `create` drops and recreates the schema on EVERY startup — only useful when
# you deliberately want a clean slate (§7.4).
JPA_DDL_AUTO=update

# --- JWT (authService) -------------------------------------------------------
# HS256 signing secret. Must be at least 256 bits. Generate a real one:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-256-bit-secret-value

# --- dsService ---------------------------------------------------------------
# REQUIRED — dsService refuses to start without it. Get one from
# https://console.mistral.ai/. Note: this is a Mistral key, not an OpenAI one.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Shared: dsService (producer) <-> expenseService (consumer) --------------
# One variable feeds both containers, so the two sides cannot drift apart.
EXPENSE_TOPIC=expense-topic
